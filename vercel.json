{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/go/:code",
      "destination": "https://oopsie.bio/ashleywow",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/to/:target/:code",
      "destination": "/api/go?target=:target&code=:code"
    }
  ]
}
